  },
  "dependencies": {
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "autoprefixer": "10.5.2",
    "browser-sync": "3.0.4",
    "chokidar": "5.0.0",
    "concurrently": "10.0.3",
    "postcss": "8.5.19",
    "prettier": "3.9.5",
    "pug": "3.0.4",
    "sass": "1.101.0",
    "shelljs": "0.10.0",
    "upath": "3.0.8"
  }
