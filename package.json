{
  "title": "Freelancer",
  "name": "startbootstrap-freelancer",
  "version": "7.0.7",
  "scripts": {
    "build": "npm run clean && npm run build:pug && npm run build:scss && npm run build:scripts && npm run build:assets && npm run build:php",
    "build:assets": "node scripts/build-assets.js",
    "build:php": "node scripts/build-php.js",
    "build:pug": "node scripts/build-pug.js",
    "build:scripts": "node scripts/build-scripts.js",
    "build:scss": "node scripts/build-scss.js",
    "clean": "node scripts/clean.js",
    "prettier": "prettier --write .",
    "start": "npm run build && node scripts/start.js",
    "start:debug": "npm run build && node scripts/start-debug.js"
  },
  "description": "A freelancer portfolio HTML theme for Bootstrap.",
  "keywords": [
    "css",
    "sass",
    "scss",
